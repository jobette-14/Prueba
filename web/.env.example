# ============================================================
# ElectroPredict API - variables de entorno (ejemplo)
# Copia este archivo a .env y completa con TUS valores reales.
# NUNCA subas el .env a Git ni lo incluyas en el codigo distribuido.
# ============================================================

# Entorno: desarrollo | produccion
ENTORNO=desarrollo

# URL de PostgreSQL/Neon. Se usa SOLO en el servidor. No se expone al navegador.
# Ejemplo: postgresql://usuario:clave@ep-xxx.neon.tech/electropredict?sslmode=require
DATABASE_URL=

# Clave para proteger las rutas de escritura (X-API-Key).
# Si esta vacia, las rutas de escritura quedan abiertas (solo para desarrollo).
ELECTROPREDICT_API_KEY=

# Origenes permitidos por CORS (separados por coma). En produccion NO uses "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Limite de solicitudes por IP para rutas sensibles.
RATE_LIMIT=120/minute

# Directorio de modelos persistidos (opcional; por defecto ./modelos).
MODELOS_DIR=

# Directorio del frontend compilado (dist de Vite).
FRONTEND_DIR=

# --- Chatbot de IA (opcional, pluggable) ---
# Si CHAT_API_KEY esta vacio, el chat queda desactivado y la app funciona igual.
CHAT_ENABLED=false
CHAT_API_KEY=
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
